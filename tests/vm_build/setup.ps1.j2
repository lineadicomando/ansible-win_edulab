# First logon of the unattended build of {{ inventory_hostname }} (tests/vm_build_windows.yaml).
# Makes the VM reachable the way docs/installation.md prepares a lab PC: OpenSSH Server
# with PowerShell as its shell, port 22 open. Then turns off sleep and hibernation and
# moves the NIC to the static address of the inventory, the last step because it drops
# the DHCP lease the capability download needs.
# Log: C:\Windows\Temp\edulab-setup.log; outcome: edulab-setup.done or edulab-setup.failed.
$ErrorActionPreference = 'Stop'
$log = 'C:\Windows\Temp\edulab-setup'
Start-Transcript -Path "$log.log" -Append
try {
    # The NIC may still be coming up at first logon, and the capability comes from
    # Windows Update: retry for about ten minutes.
    $cap = 'OpenSSH.Server~~~~0.0.1.0'
    for ($i = 1; $i -le 20; $i++) {
        if ((Get-WindowsCapability -Online -Name $cap).State -eq 'Installed') { break }
        try {
            Add-WindowsCapability -Online -Name $cap | Out-Null
        } catch {
            Write-Output "Add-WindowsCapability, attempt ${i}: $($_.Exception.Message)"
            Start-Sleep -Seconds 30
        }
    }
    if ((Get-WindowsCapability -Online -Name $cap).State -ne 'Installed') {
        throw "$cap is not installed"
    }
    Set-Service -Name sshd -StartupType Automatic
    Start-Service -Name sshd
    New-Item -Path HKLM:\SOFTWARE\OpenSSH -Force | Out-Null
    New-ItemProperty -Path HKLM:\SOFTWARE\OpenSSH -Name DefaultShell -PropertyType String -Force `
        -Value "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe" | Out-Null
    if (-not (Get-NetFirewallRule -Name OpenSSH-Server-In-TCP -ErrorAction SilentlyContinue)) {
        New-NetFirewallRule -Name OpenSSH-Server-In-TCP -DisplayName 'OpenSSH SSH Server (sshd)' `
            -Direction Inbound -Protocol TCP -LocalPort 22 -Action Allow | Out-Null
    }
    Set-NetFirewallRule -Name OpenSSH-Server-In-TCP -Enabled True -Profile Any

    # A test VM that falls asleep looks unreachable; hibernation also keeps fast
    # startup on, which leaves the disk of a shut-off baseline in a hibernated state.
    powercfg.exe /change standby-timeout-ac 0
    powercfg.exe /hibernate off

    # The autologon of the answer file has done its job: clear what Winlogon kept.
    $winlogon = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'
    Set-ItemProperty -Path $winlogon -Name AutoAdminLogon -Value '0'
    Remove-ItemProperty -Path $winlogon -Name DefaultPassword -ErrorAction SilentlyContinue

    $nic = Get-NetAdapter -Physical | Where-Object Status -eq 'Up' | Select-Object -First 1
    if (-not $nic) { throw 'no network adapter is up' }
    try {
        Set-NetConnectionProfile -InterfaceIndex $nic.ifIndex -NetworkCategory Private
    } catch {
        Write-Output "Set-NetConnectionProfile: $($_.Exception.Message)"
    }
    Set-NetIPInterface -InterfaceIndex $nic.ifIndex -AddressFamily IPv4 -Dhcp Disabled
    Get-NetIPAddress -InterfaceIndex $nic.ifIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue |
        Remove-NetIPAddress -Confirm:$false -ErrorAction SilentlyContinue
    Get-NetRoute -InterfaceIndex $nic.ifIndex -DestinationPrefix 0.0.0.0/0 -ErrorAction SilentlyContinue |
        Remove-NetRoute -Confirm:$false -ErrorAction SilentlyContinue
    New-NetIPAddress -InterfaceIndex $nic.ifIndex -IPAddress {{ ansible_host }} `
        -PrefixLength {{ ansible_subnet.split('/')[1] }} -DefaultGateway {{ test_vm_gateway }} | Out-Null
    Set-DnsClientServerAddress -InterfaceIndex $nic.ifIndex -ServerAddresses {{ test_vm_dns }}

    New-Item -Path "$log.done" -ItemType File -Force | Out-Null
} catch {
    Write-Output "FAILED: $($_.Exception.Message)"
    New-Item -Path "$log.failed" -ItemType File -Force | Out-Null
} finally {
    Stop-Transcript
}
